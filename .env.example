# ==============================================================================
# DAILY BRIEF FRONTEND (READER APP) - ENVIRONMENT TEMPLATE
# ==============================================================================

# Core App
NODE_ENV=production
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_SITE_URL=https://civibrief-frontend-qc1z.vercel.app
NEXT_PUBLIC_ADMIN_URL=https://daily-brief-admin.vercel.app

# Real-Time Market Ticker (Binance Data API)
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# Cloudflare D1 Serverless Database (Database: civibrief)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_D1_DATABASE_ID=your_d1_database_id_here
CLOUDFLARE_D1_API_TOKEN=your_cloudflare_api_token_here

# Customer Support
NEXT_PUBLIC_SUPPORT_EMAIL=customersupport@dailybrief.com
NEXT_PUBLIC_SUPPORT_PHONE=1800 102 1878

